    {
      "id": "file:app.py",
      "type": "file",
      "name": "app.py",
      "filePath": "app.py",
      "summary": "Streamlit 应用入口，串联出生信息表单、星盘计算、LLM 流式解读、报告导出与可选三张塔罗牌流程。它同时负责 session_state 缓存、错误呈现和移动端暗色界面渲染。",
      "tags": ["入口点", "streamlit-ui", "工作流编排", "会话状态", "报告生成"],
      "complexity": "complex",
      "languageNotes": "采用 Streamlit 的脚本重跑模型，以 session_state 和输入指纹维持跨重跑状态，并通过 st.write_stream 消费 LLM 流式输出。"
    },
