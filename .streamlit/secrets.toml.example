# Copy to secrets.toml and fill in. Never commit secrets.toml.

# --- Option A: OpenAI ---
# OPENAI_API_KEY = "sk-..."
# OPENAI_MODEL = "gpt-4o-mini"
# OPENAI_BASE_URL = "https://api.openai.com/v1"

# --- Option B: DeepSeek (cheaper for spike testing; OpenAI-compatible) ---
OPENAI_API_KEY = "sk-..."
OPENAI_MODEL = "deepseek-chat"
OPENAI_BASE_URL = "https://api.deepseek.com"

# Free GeoNames username: https://www.geonames.org/login
GEONAMES_USERNAME = "your_geonames_username"
