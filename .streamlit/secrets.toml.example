# Copy to secrets.toml and fill in. Never commit secrets.toml.

# --- Option A: OpenAI ---
# OPENAI_API_KEY = "sk-..."
# OPENAI_MODEL = "gpt-4o-mini"
# OPENAI_BASE_URL = "https://api.openai.com/v1"

# --- Option B: DeepSeek (cheaper for spike testing; OpenAI-compatible) ---
OPENAI_API_KEY = "sk-..."
OPENAI_MODEL = "deepseek-chat"
OPENAI_BASE_URL = "https://api.deepseek.com"

# Free GeoNames username: https://www.geonames.org/login
GEONAMES_USERNAME = "your_geonames_username"

# Optional: password-gated「运营统计」at page footer (Cloud-friendly backup)
# STATS_PASSWORD = "choose-a-long-secret"
# Optional counter offsets after Cloud rebuilds:
# GENERATION_COUNT_BASE = "0"
# QUESTION_COUNT_BASE = "0"
# USAGE_DB_PATH = ""  # default: cache/usage.sqlite
